# Every tool the lane runs, pinned by checksum or commit. tools.sh refuses a download that does not match.
JDK_VERSION=21.0.13+9
JDK_URL=https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13%2B9/OpenJDK21U-jdk_x64_linux_hotspot_21.0.13_9.tar.gz
JDK_SHA256=d7f5d5cf865a2902b70ff549b97586a7d3f234e016f041ab447ea740c7d66d1c

MAVEN_VERSION=3.9.12
MAVEN_URL=https://archive.apache.org/dist/maven/maven-3/3.9.12/binaries/apache-maven-3.9.12-bin.tar.gz
MAVEN_SHA512=0a1be79f02466533fc1a80abbef8796e4f737c46c6574ede5658b110899942a94db634477dfd3745501c80aef9aac0d4f841d38574373f7e2d24cce89d694f70

# imaptest publishes only a moving "latest" binary and follows Dovecot's unreleased API, so the lane builds both at a
# commit: Dovecot core the last commit before imaptest's, as imaptest's CI builds them together.
IMAPTEST_REPO=https://github.com/dovecot/imaptest.git
IMAPTEST_COMMIT=2163941e2ce68c3a46ad624541eea64e0185f5b3
DOVECOT_REPO=https://github.com/dovecot/core.git
DOVECOT_COMMIT=a5e161cebc257e685f97950b267f2dc05039732f

# Their build tools, verified by signature when pinned: GNU's against gnu-keyring.gpg, flex against Will Estes's
# 56C67868E93390AA1039AD1CE4B29C8D64885307. gettext gives only its iconv macros, for Dovecot's AM_ICONV.
M4_URL=https://ftp.gnu.org/gnu/m4/m4-1.4.21.tar.xz
M4_SHA256=f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66
