# The restore drill runs production's backup tools (agromarin-infra: pgBackRest for PostgreSQL, restic for the
# off-site copy), unpacked from Ubuntu's packages without installing them.
PGBACKREST_URL=http://archive.ubuntu.com/ubuntu/pool/universe/p/pgbackrest/pgbackrest_2.58.0-1_amd64.deb
